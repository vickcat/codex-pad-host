# ===== Codex 外设主机桥接服务配置 =====
# 复制为 config.env 并修改（config.env 不入 git）

# 局域网服务端口
LAN_VOICE_PORT=8765
LAN_DISCOVERY_PORT=8766
LAN_DISCOVERY_ENABLED=1

# 局域网共享密钥（必须与固件 config.h 的 LAN_SHARED_SECRET 一致）
LAN_SHARED_SECRET=codex-peripheral-dev-secret-2026

# ===== 火山引擎 ASR（大模型语音识别-闪速版） =====
# 凭证：豆包语音控制台 API Key 管理创建的单字段 UUID（⚠️ 勿外泄、勿提交 git）
ASR_PROVIDER=volcengine
VOLCENGINE_API_KEY=你的_单字段_API_Key
VOLCENGINE_RESOURCE_ID=volc.bigasr.auc_turbo
# 调试：把收到的录音存为 WAV（tmp/ 目录）
SAVE_DEBUG_WAV=0

# ===== CLI 会话托管（Phase 5） =====
# 默认投递 Agent（设备端未带 agentId 时使用）
CLI_DEFAULT_AGENT=agent-1
# Agent 池类型：codex / claude / mock（真实 CLI 模型不可用时用 mock 联调）
CLI_AGENT1_TYPE=codex
CLI_AGENT2_TYPE=claude
CLI_AGENT3_TYPE=mock
# codex 模型覆盖（config.toml 的模型名可能无效/别名；代理只认 deepseek-v4-pro / deepseek-v4-flash）
CODEX_MODEL=deepseek-v4-flash
# codex 沙箱：read-only(默认安全) | workspace-write(允许写工作区，真正写代码用) | danger-full-access
CODEX_SANDBOX=read-only
# 投递模式：cli=转写确认后送入 Agent 会话托管 / inject=剪贴板注入前台窗口
TRANSCRIPT_DELIVERY_MODE=cli

# 可选：覆盖 CLI 命令与工作目录
# CODEX_COMMAND=codex
# CODEX_CWD=D:/path/to/project
# CLAUDE_COMMAND=claude
# CLAUDE_CWD=D:/path/to/project
# 自定义 Agent 池（逗号分隔 id:type:name:cwd，优先于 CLI_AGENT*_TYPE）
# CLI_AGENTS=agent-1:codex:主Agent:D:/proj1,agent-2:claude:副Agent:D:/proj2
